{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "leads": {
        "ClusterId": "leads",
        "Match": { "Path": "/api/leads/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },

      "customers": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/customers/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "deals": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/deals/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "tasks": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/tasks/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "interactions": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/interactions/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "dashboard": {
        "ClusterId": "customer",
        "Match": { "Path": "/api/dashboard/{**rest}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },

      "customer-openapi": {
        "ClusterId": "customer",
        "Match": { "Path": "/docs/customer/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      },
      "leads-openapi": {
        "ClusterId": "leads",
        "Match": { "Path": "/docs/leads/swagger.json" },
        "Transforms": [ { "PathSet": "/swagger/v1/swagger.json" } ]
      }
    },

    "Clusters": {
      "customer": {
        "Destinations": { "primary": { "Address": "http://localhost:5067/" } },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      },
      "leads": {
        "Destinations": { "primary": { "Address": "http://localhost:5080/" } },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": { "Enabled": true, "Interval": "00:00:05", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health" }
        }
      }
    }
  }
}
